generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==== Core tables ====
model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  role         Role       @default(BUYER)
  isVerified   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  profile      Profile?
  properties   Property[]
  // relations for auth tokens, etc.
}

enum Role {
  BUYER
  SELLER
  ADMIN
  VERIFICATION_OFFICER
  SUPPORT_AGENT
  FINANCE_ADMIN
  COMPLIANCE_OFFICER
  SUPER_ADMIN
}

model Profile {
  id        String   @id @default(uuid())
  userId    String   @unique
  firstName String
  lastName  String
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Property {
  id            String                 @id @default(uuid())
  sellerId      String
  title         String
  slug          String                 @unique
  description   String?
  propertyType  PropertyType
  listingType   ListingType
  price         Decimal
  currency      String                 @default("INR")
  negotiable    Boolean                @default(false)
  status        PropertyStatus         @default(DRAFT)
  bedrooms      Int?
  bathrooms     Int?
  balconies     Int?
  floor         Int?
  totalFloors   Int?
  builtUpArea   Float?
  carpetArea    Float?
  landArea      Float?
  parking       Int?
  furnishing    String?
  propertyAge   Int?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  seller        User                   @relation(fields: [sellerId], references: [id])
  media         PropertyMedia[]
  locations     PropertyLocation?
  amenities     PropertyAmenity[]
  verifications PropertyVerification[]
}

enum PropertyType {
  APARTMENT
  VILLA
  INDEPENDENT_HOUSE
  PLOT
  LAND
  COMMERCIAL_PROPERTY
  OFFICE
  SHOP
  WAREHOUSE
  FARM_PROPERTY
  AGRICULTURAL_LAND
  OTHER
}

enum ListingType {
  FOR_SALE
  FOR_RENT
}

enum PropertyStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
  SOLD
}

model PropertyLocation {
  id         String   @id @default(uuid())
  propertyId String   @unique
  country    String
  state      String
  city       String
  locality   String?
  postalCode String?
  latitude   Float?
  longitude  Float?
  property   Property @relation(fields: [propertyId], references: [id])
}

model PropertyMedia {
  id         String    @id @default(uuid())
  propertyId String
  type       MediaType
  url        String
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  property   Property  @relation(fields: [propertyId], references: [id])
}

enum MediaType {
  IMAGE
  VIDEO
  FLOOR_PLAN
}

model PropertyAmenity {
  id         String   @id @default(uuid())
  propertyId String
  name       String
  property   Property @relation(fields: [propertyId], references: [id])
}

model PropertyVerification {
  id         String             @id @default(uuid())
  propertyId String
  status     VerificationStatus @default(DRAFT)
  reviewerId String?
  reviewedAt DateTime?
  notes      String?
  property   Property           @relation(fields: [propertyId], references: [id])
}

enum VerificationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

// Additional tables (offers, visits, chats, payments, fees, notifications, etc.) will be added later.
